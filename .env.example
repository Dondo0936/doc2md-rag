# Optional: enables Claude Vision for AI-powered image descriptions in PDFs
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Parser Platform API (FastAPI)
PARSER_MAX_FILE_MB=100
PARSER_SYNC_MAX_MB=10
PARSER_FETCH_TIMEOUT=30
PARSER_FETCH_MAX_MB=25
PARSER_FETCH_MAX_REDIRECTS=5
PARSER_QUALITY_MIN_CHARS=10
PARSER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ENABLE_IMAGE_DESC=1   # Docling SmolVLM image descriptions (RAM-heavy)

# Optional: API-based embedding models (only set the ones you plan to use)

# OpenAI — for text-embedding-3-small / text-embedding-3-large
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Voyage AI (Anthropic-recommended) — for voyage-3.5-lite
# Get your key at https://dash.voyageai.com
VOYAGE_API_KEY=pa-...

# Google Gemini — for gemini-embedding-001 / text-embedding-004
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AI...
